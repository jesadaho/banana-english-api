GEMINI_API_KEY=your-gemini-api-key-here
# Comma-separated priority list; first model is primary, rest are fallbacks
GEMINI_CHAT_MODEL=gemini-3.5-flash,gemini-2.5-flash
# Hours to skip a model after 503/high-demand (default 2)
GEMINI_CHAT_MODEL_COOLDOWN_HOURS=2
# Deprecated — append extra models to GEMINI_CHAT_MODEL instead
# GEMINI_CHAT_FALLBACK_MODEL=gemini-2.5-flash
# Primary TTS model only (single id — older Gemini Direct clients don't split commas)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Fallback TTS models for newer clients + server TTS pool (comma-separated)
GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-pro-preview-tts,gemini-2.5-flash-preview-tts
# Hours to skip a TTS model after 503/high-demand (default 2)
GEMINI_TTS_MODEL_COOLDOWN_HOURS=2
GEMINI_TTS_VOICE=Sadachbia
# Google Cloud Text-to-Speech — preferred: short-lived token for client-direct TTS
# Create a service account with roles/aiplatform.user (+ Cloud TTS access)
GOOGLE_CLOUD_TTS_CREDENTIALS_JSON=
# Or split fields instead of JSON:
# GOOGLE_CLOUD_TTS_CLIENT_EMAIL=
# GOOGLE_CLOUD_TTS_PRIVATE_KEY=
GOOGLE_CLOUD_TTS_MODEL=gemini-2.5-flash-tts
GOOGLE_CLOUD_TTS_VOICE=Sadachbia
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Legacy client API key (only used when token minting is not configured)
# GOOGLE_CLOUD_TTS_API_KEY=
# client = app talks to Gemini TTS directly (default, smoother on Android)
# cloud = app talks to Cloud Text-to-Speech Gemini TTS directly
# server = app streams TTS through this backend proxy
DEFAULT_TTS_MODE=client
GROQ_API_KEY=gsk_your-groq-key-here
# Optional: comma-separated Groq keys. Server assigns one key per app launch
# (round-robin) so Whisper RPM is spread across orgs. Preferred over GROQ_API_KEY.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three
# Training lesson LLM: gemini (default) | groq
TRAINING_LLM_PROVIDER=gemini
# Groq chat model when TRAINING_LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b
PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/banana_english
FIREBASE_PROJECT_ID=banana-english-ecf11
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=banana-english-ecf11.firebasestorage.app
# Local dev + Flutter web origin; add Railway/public URLs in production
# Firebase Hosting (*.web.app / *.firebaseapp.com) and bananaenglish.app
# are allowed in code without listing here.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Comma-separated Google account emails allowed to call GET /admin/metrics/*
ADMIN_EMAILS=you@example.com
# Stale guest cleanup (cron 04:10 UTC daily): off | dry-run | execute
# dry-run = log match count only; execute = delete abandoned guests (safe: app upserts again)
STALE_GUEST_CLEANUP_MODE=dry-run
STALE_GUEST_CLEANUP_DAYS=30
# STALE_GUEST_CLEANUP_BATCH=500
ENABLE_DEBUG_ENDPOINTS=true
SESSION_DURATION_SECONDS=300
# Economy — bananas granted to users (defaults match previous hard-coded values)
ONBOARDING_BANANA_BONUS=2
# Free pool soft cap stays at baseCap (timed +1 / 4h). Signup-day bonuses are
# one-shot uncapped credits: Day0 +3, Day1 +2, Day2 +2 → entitlement 8/7/7/5.
BANANA_DAY_BONUS={"baseCap":5,"day0":3,"day1":2,"day2":2}
# BANANA_BONUS_DAY0=3
# BANANA_BONUS_DAY1=2
# BANANA_BONUS_DAY2=2
# MAX_BANANA_BALANCE=5
# Legacy entitlement JSON still accepted (maps to base+bonus).
# BANANA_DAY_CAPS={"day0":8,"day1to2":7,"day3plus":5}
# Legacy field still reported to old app builds when no user context.
DAILY_BANANA_DROP=5
# DEBUG_BANANA_REFILL=2
# Optional Firebase RC: banana_day_bonus (or legacy banana_day_caps) — env wins.
# Public Bunny pull zone for pre-conversation cutscenes. No trailing slash.
# Clips are listed in src/learn-path/conversation-cutscenes.ts.
# BUNNY_CUTSCENE_BASE_URL=https://your-zone.b-cdn.net
# Banana Originals clip audio/covers (defaults to cutscene pull zone).
# BUNNY_CLIPS_BASE_URL=https://banana-english-cutscenes.b-cdn.net
# BUNNY_STORAGE_HOST=https://sg.storage.bunnycdn.com
# RevenueCat — IAP banana shop
# REVENUECAT_WEBHOOK_AUTH=your-webhook-secret
# Secret API key (REST) — required to verify client claims before granting bananas
# REVENUECAT_SECRET_API_KEY=sk_xxxxx
# Beam Checkout — Founder Presale PromptPay.
# Production base URL is the default. BEAM_WEBHOOK_SECRET is the base64 HMAC
# key from Lighthouse, not a decoded string.
# Webhook: POST /presale/beam/webhook  event charge.succeeded
# BEAM_MERCHANT_ID=
# BEAM_API_KEY=
# BEAM_WEBHOOK_SECRET=
# BEAM_API_BASE=https://api.beamcheckout.com
# Telegram — purchase alerts (Pro INITIAL, banana packs, Beam PromptPay).
# Empty = disabled. Failures never break RevenueCat/Beam webhooks.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PURCHASE_CHAT_ID=

# Live Talk captions agent (agents/live-talk-captions). "off" disables dispatch.
LIVE_TALK_CAPTIONS_AGENT=banana-captions
