generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  BANANA
  XP
  BANANA_SEED
}

enum SubscriptionTier {
  FREE
  PRO
  PRO_MAX
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  FINALIZING
  REWARDED
  ARCHIVED
}

enum EventRewardType {
  AVATAR
}

model User {
  id                      String    @id @default(uuid())
  anonymousId             String    @unique
  displayName             String?
  timezone                String    @default("Asia/Bangkok")
  onboardingCompleted     Boolean   @default(false)

  /** Latest speaking-placement result payload (v1.5). */
  placementResult         Json?
  /** Path/node the learner may start at without completing earlier nodes. */
  placementEntryPathId    String?
  placementEntryNodeId    String?
  /** Last onboarding/paid Level Test start — one calendar month in the learner tz. */
  lastPlacementTestAt     DateTime?

  /** Daily speaking reminder: "morning" | "noon" | "evening". Null = not opted in. */
  reminderSlot            String?
  /** Last daily-practice template ids (avoid repeats within 7 sends). */
  dailyPracticeTemplateIds String[] @default([])
  /** Last weekly-report template ids (avoid repeats across pieces). */
  weeklyReportTemplateIds String[] @default([])
  /** App content language: "th" | "en". Synced from the client locale. */
  contentLocale           String    @default("th")

  bananaBalance           Int       @default(0)
  /** Daily free pool (capped). Spends this before accumulated bananas. */
  freeBananaBalance       Int       @default(0)
  xpBalance               Int       @default(0)
  bananaSeedBalance       Int       @default(0)
  unlockedAvatarIds       String[]  @default([])
  /** Currently selected profile avatar id (catalog). */
  avatarId                String?

  /** Most recent training lesson started (for social "currently on" proof). */
  lastStudiedLessonId     String?
  lastStudiedAt           DateTime?

  /** Last started mission / minigame (intro avatar stack). */
  lastActivityKind        String?
  lastActivityId          String?
  lastActivityAt          DateTime?

  streakDays              Int       @default(0)
  lastSessionDate         DateTime? @db.Date
  streakMilestonesClaimed Int[]     @default([])
  /** Highest streakDays ever reached (survives streak resets). */
  longestStreakDays       Int       @default(0)

  /** Lifetime Daily Speak completions (once per local day). */
  dailySpeakCount         Int       @default(0)

  /** Lifetime spoken turns accepted by the session API (not Continue taps). */
  spokenCount             Int       @default(0)

  lastDailyBananaDate     DateTime? @db.Date
  lastBananaRefillAt      DateTime?
  lastAppOpenDate         DateTime? @db.Date
  /** Client at the last app open (X-App-Platform / X-App-Version): ios, android, web. */
  appPlatform             String?
  /** e.g. "1.0.21+45" at the last app open. */
  appVersion              String?
  /** App version when this user was first seen — cohort / drop-off analysis. */
  firstAppVersion         String?
  dailyMissionUsedDate    DateTime? @db.Date

  /** Top Free Talk memories from the latest session (max 5, overwritten each end). */
  freeTalkMemories        String[]  @default([])

  /** How Teacher B speaks during lessons: "thai" | "english". */
  lessonTeachingLanguage  String    @default("thai")

  /**
   * Self-reported English level from onboarding survey:
   * "beginner" | "elementary" | "intermediate" | "advanced"
   */
  selfReportedEnglishLevel String?

  /**
   * How the learner found Banana English (onboarding acquisition survey):
   * "tiktok" | "facebook" | "friend_line" | "google" | "app_store" | "other" | "skipped"
   */
  acquisitionSource String?

  /**
   * Onboarding demographics survey:
   * "female" | "male" | "prefer_not_say"
   */
  surveyGender String?

  /**
   * Onboarding age band:
   * "under_18" | "18_24" | "25_34" | "35_44" | "45_plus"
   */
  surveyAgeRange String?

  /** True after the learner finishes any Vocab Drill with zero mistakes. */
  perfectVocabDrillCompleted Boolean @default(false)

  /** Firebase Auth UID after linking Apple/Google sign-in. */
  firebaseUid             String?   @unique
  /** Rotated on each Google/Apple login — old devices are rejected. */
  authSessionId           String?
  /** Primary email from linked auth provider(s). */
  email                   String?

  /** Can create Live Talk rooms (toggled from web admin). */
  communityAdmin          Boolean   @default(false)
  /** Live Talk host level: none | trainee | host | official. */
  hostLevel               String    @default("none")
  hostLevelAt             DateTime?
  /** First time the user accepted the Live Talk host rules (Trainee onboarding). */
  hostRulesAcceptedAt     DateTime?

  /** Invite-a-friend code (`BANANA-XXXX`), minted on first use. */
  referralCode            String?   @unique

  /** Active plan. Ignored once [subscriptionExpiresAt] is in the past. */
  subscriptionTier        SubscriptionTier @default(FREE)
  subscriptionExpiresAt   DateTime?
  /** Pro Max Early Bird reservation (final presale). Null = not reserved. */
  earlyBirdReservedAt     DateTime?
  /** "offer_day_1" | "offer_day_3" | ... | "settings" */
  earlyBirdReserveSource  String?

  fcmTokens               UserFcmToken[]
  referralsSent             Referral[] @relation("ReferralReferrer")
  referredBy                Referral?  @relation("ReferralInvitee")
  authProviders           UserAuthProvider[]
  transactions            EconomyTransaction[]
  sessions                UserSession[]
  lessonRatings           LessonRating[]
  notificationLogs        NotificationLog[]
  userNotifications       UserNotification[]
  achievements            UserAchievement[]
  outfits                 UserOutfit[]
  emojiSpeakEndlessWeeklyScores EmojiSpeakEndlessWeeklyScore[]
  wordCardsEndlessScores        WordCardsEndlessScore[]
  explainItTopicScores      ExplainItTopicScore[]
  purchaseRecords           PurchaseRecord[]
  purchaseAttempts          PurchaseAttempt[]
  phonicsNodeProgress       PhonicsNodeProgress[]
  foundationChapterSkips    FoundationChapterSkip[]
  foundationSkipQuizAttempts FoundationSkipQuizAttempt[]
  miniGameScoreAttempts     MiniGameScoreAttempt[]
  perfectStars              UserPerfectStar[]
  scenarioProgress          InteractiveScenarioProgress[]
  spokenDays                UserSpokenDay[]
  activeDays                UserActiveDay[]
  bugReports                BugReport[]
  subscriptionGrants      SubscriptionGrant[]
  presaleOrders           PresaleOrder[]
  hostedLiveTalkRooms     LiveTalkRoom[]
  liveTalkParticipations  LiveTalkParticipant[]
  liveTalkRatings         LiveTalkRating[]
  hostLevelEvents         HostLevelEvent[]      @relation("HostLevelSubject")
  hostLevelActions        HostLevelEvent[]      @relation("HostLevelActor")
  liveTalkInvitesSent     LiveTalkInvite[]      @relation("LiveTalkInviter")
  liveTalkInvitesReceived LiveTalkInvite[]      @relation("LiveTalkInvitee")
  liveTalkSessions        LiveTalkSession[]     @relation("LiveTalkSessionHost")
  weeklyReportSnapshots   WeeklyReportSnapshot[]
  eventLeaderboardRows    EventLeaderboard[]
  eventScoreAttempts      EventScoreAttempt[]
  eventResults            EventResult[]
  eventRewardGrants       EventRewardGrant[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([lastStudiedLessonId, lastStudiedAt])
  @@index([lastActivityKind, lastActivityId, lastActivityAt])
  @@index([earlyBirdReservedAt])
  @@index([lastAppOpenDate])
}

/** Frozen Sunday-evening weekly report for one learner / ISO week. */
model WeeklyReportSnapshot {
  id         String   @id @default(uuid())
  userId     String
  weekKey    String
  segment    String
  templateId String
  locale     String
  title      String
  body       String
  payload    Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([createdAt])
}

/** Invite-a-friend link between a referrer and the friend who used their code. */
model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  inviteeId    String    @unique
  code         String
  /** "play_referrer" | "clipboard" | "link" | "manual" */
  source       String
  /** "pending" | "rewarded" | "capped" */
  status       String    @default("pending")
  qualifiedAt  DateTime?
  /** Referrer saw the reward sheet. */
  rewardSeenAt DateTime?
  createdAt    DateTime  @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  invitee  User @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([referrerId, qualifiedAt])
}

/** One grant or renewal of Pro / Pro Max. History is kept after revoke. */
model SubscriptionGrant {
  id        String           @id @default(uuid())
  userId    String
  tier      SubscriptionTier
  startsAt  DateTime
  expiresAt DateTime
  /** "founder_presale" | "admin" | "revenuecat" */
  source    String
  note      String?
  priceThb  Int?
  /** Store subscription product (RevenueCat grants only). */
  productId          String?
  /** One row per store transaction (initial purchase or renewal). */
  storeTransactionId String?  @unique
  /** "ios" | "android" */
  platform           String?
  isSandbox          Boolean?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
}

/** Founder presale checkout. Quota counts rows with status "paid". */
model PresaleOrder {
  id            String           @id @default(uuid())
  /** Null until the buyer logs into the app and we attach the profile. */
  userId        String?
  /** Firebase Auth UID from the presale web sign-in (Google/Apple). */
  firebaseUid   String
  /** Google/Apple email from the checkout token. Set even before app login. */
  email         String?
  tier          SubscriptionTier @default(PRO_MAX)
  priceThb      Int
  /** "pending_payment" | "paid" | "expired" */
  status        String           @default("pending_payment")
  beamChargeId  String?          @unique
  /** PNG data URL or raw base64 from Beam, so the page can poll without another charge. */
  qrImageBase64 String?
  createdAt     DateTime         @default(now())
  paidAt        DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([firebaseUid, status])
  @@index([status, createdAt])
}

model EconomyTransaction {
  id          String   @id @default(uuid())
  userId      String
  currency    Currency
  amount      Int
  source      String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserAuthProvider {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerUid String
  email       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id     String   @id @default(uuid())
  userId String
  type   String
  sentOn DateTime @db.Date
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sentOn])
}

model UserNotification {
  id     String    @id @default(uuid())
  userId String
  type   String
  title  String
  body   String
  data   Json?
  sentAt DateTime  @default(now())
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, readAt])
}

model UserSession {
  id              String    @id
  userId          String
  sessionType     String
  simulationId    String?
  lessonId        String?
  isDailyMission  Boolean   @default(false)
  rewardsApplied  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  overallScore    Int?
  scoreLabel      String?
  xpEarned        Int?
  seedsEarned     Int?
  durationSeconds Int?
  reportJson      Json?
  /** Hint sheet opens this session (null = not tracked / pre-achievements). */
  hintsUsed       Int?
  /** True if Thai Mix was used on any turn (null = not tracked). */
  thaiMixUsed     Boolean?
  /** Learner (user) turns this session (null = not tracked / pre-stats). */
  learnerTurnCount Int?
  /** Lesson teaching language for training sessions: "thai" | "english". */
  teachingLanguage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completedAt])
  @@index([userId, lessonId])
  @@index([lessonId, createdAt])
}

/** Learner star rating after finishing a lesson (1–5). */
model LessonRating {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  sessionId String?
  stars     Int
  /** Optional free-text feedback (usually when stars < 5). */
  feedback  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([lessonId, createdAt])
  @@index([userId, lessonId])
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  /** Set once the user claims the badge reward (null = reward still pending). */
  claimedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserOutfit {
  id       String   @id @default(uuid())
  userId   String
  outfitId String
  /** Achievement that granted this outfit (null = granted by other sources). */
  sourceAchievementId String?
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outfitId])
  @@index([userId])
}

/** Weekly personal best for Emoji Speak Endless (Mon–Sun, Asia/Bangkok week key). */
model EmojiSpeakEndlessWeeklyScore {
  id          String   @id @default(uuid())
  userId      String
  weekKey     String
  bestScore   Int
  displayName String?
  avatarId    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([weekKey, bestScore])
}

/** Word Cards Endless best per user per week (`weekKey` = ISO week in Bangkok, e.g. `2026-W44`). */
model WordCardsEndlessScore {
  id          String   @id @default(uuid())
  userId      String
  weekKey     String
  bestScore   Int
  displayName String?
  avatarId    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([weekKey, bestScore])
}

/** Personal best per Explain It topic (all-time Top 10). */
model ExplainItTopicScore {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  bestScore   Int
  displayName String?
  avatarId    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId, bestScore])
}

/** Server-owned phonics check attempts and pass state. */
model PhonicsNodeProgress {
  id           String   @id @default(uuid())
  userId       String
  nodeId       String
  attemptCount Int      @default(0)
  passed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, passed])
}

/** Chapter marked skipped after passing a skip quiz (≠ completed for badges). */
model FoundationChapterSkip {
  id              String   @id @default(uuid())
  userId          String
  pathId          String
  chapterId       String
  skippedNodeIds  Json
  quizCorrect     Int
  quizTotal       Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId, chapterId])
  @@index([userId, pathId])
}

/** Paid skip-quiz attempt; idempotencyKey prevents double banana charge on retry. */
model FoundationSkipQuizAttempt {
  id                 String   @id @default(uuid())
  userId             String
  pathId             String
  targetChapterId    String
  previousChapterId  String
  idempotencyKey     String
  items              Json
  totalCount         Int
  bananaCost         Int      @default(1)
  spendRef           String
  status             String   @default("started")
  correctCount       Int?
  passed             Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, pathId, targetChapterId])
}

/**
 * Append-only mini-game / path-stage scores (Say It, Describe It, Emoji Speak,
 * New Words, Skip Quiz, etc.) for admin Content analytics.
 */
model MiniGameScoreAttempt {
  id           String   @id @default(uuid())
  userId       String
  /** Canonical reward / stage id, e.g. say_it:fnd_v7_u03n04, skip_quiz:v7_u04. */
  gameId       String
  /** say_it | describe_it | emoji_speak | new_words | skip_quiz | other */
  kind         String
  correctCount Int
  totalCount   Int
  passed       Boolean?
  /** Number of hint levels revealed during the run (hints never cost stars). */
  hintsUsed    Int?
  /** True when any hint was used: logged as assisted vs independent. */
  assisted     Boolean?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([kind, createdAt])
  @@index([userId, gameId, createdAt])
}

/** One Perfect Star per mini-game pool/topic cleared with every answer right. */
model UserPerfectStar {
  userId    String
  /** emoji_speak | word_choice | speak_challenge | story_builder | whats_happen | say_it | describe_it | explain_it | listen_up */
  game      String
  poolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, game, poolId])
}

/** Scene-level checkpoint progress so a multi-scene scenario can be resumed. */
model InteractiveScenarioProgress {
  userId            String
  scenarioId        String
  completedSceneIds Json
  checkpoints       Json
  goalOutcomes      Json
  slots             Json
  /** Set once the last scene is finished; the next start begins from scene 1. */
  finishedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scenarioId])
}

/** One row per user per UTC day the app was opened (profile sync). */
model UserActiveDay {
  userId String
  /** UTC calendar day. */
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

/** Per user per UTC day speaking tallies (lessons/missions use UserSession.learnerTurnCount). */
model UserSpokenDay {
  userId                String
  /** UTC calendar day. */
  day                   DateTime @db.Date
  /** Mini-game utterances. */
  count                 Int      @default(0)
  /** Every Speak Today finish, including replays after the daily reward. */
  dailySpeakCompletions Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

/** Verified in-app purchase (RevenueCat / App Store / Play). */
model PurchaseRecord {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  storeTransactionId String   @unique
  bananasGranted     Int
  platform           String?
  /// RevenueCat is_sandbox (App Store sandbox / Play license tester); null = not checked yet.
  isSandbox          Boolean?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** Store-paid IAP attempt, written before / even if claim fails. */
model PurchaseAttempt {
  id                 String   @id @default(uuid())
  userId             String?
  /** RevenueCat / Firebase app user id when the User row is not found yet. */
  appUserId          String?
  productId          String
  storeTransactionId String
  platform           String?
  source             String
  status             String
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/** In-app support tickets. Screenshots live in Firebase Storage (`screenshotPath`). */
model BugReport {
  id             String   @id @default(uuid())
  ticketNumber   Int      @unique @default(autoincrement())
  userId         String
  message        String
  screenshotPath String?
  appVersion     String?
  buildNumber    String?
  platform       String?
  locale         String?
  route          String?
  /** "open" | "done" */
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages BugReportMessage[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Thread replies on a bug ticket (the ticket's own message is the first post).
model BugReportMessage {
  id        String   @id @default(uuid())
  reportId  String
  /// "admin" | "user"
  author    String
  body      String
  createdAt DateTime @default(now())

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  category      String
  bodyMarkdown  String
  heroImageUrl  String?
  published     Boolean   @default(false)
  publishedAt   DateTime  @default(now())
  viewCount     Int       @default(0)
  clapCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  engagements ArticleEngagement[]

  @@index([published, publishedAt])
}

/** Anonymous per-visitor views/claps for public articles (Medium-style). */
model ArticleEngagement {
  id        String   @id @default(uuid())
  articleId String
  visitorId String
  viewed    Boolean  @default(false)
  clapCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, visitorId])
  @@index([articleId])
}

/**
 * Spoken lines the API sent without a banked clip, so the app calls live TTS.
 * One row per normalized sentence. hitCount is lifetime.
 */
model TtsLiveLine {
  /** sha256 of the whitespace-collapsed spoken text. */
  textKey     String   @id
  text        String
  /** lesson | conversation | free_talk | scenario | intro | chat */
  source      String
  hitCount    Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([hitCount])
  @@index([lastSeenAt])
  @@index([source, hitCount])
}

/// In-progress chat/lesson session state (SessionData JSON) so a deploy or
/// restart does not drop learners mid-lesson. The API keeps a memory cache
/// and writes through after each request; rows expire after 24h.
model LiveSession {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([expiresAt])
}

/// Live Talk voice room (not [LiveSession] chat JSON).
model LiveTalkRoom {
  id              String    @id @default(uuid())
  title           String
  description     String    @default("")
  /** a1 | a2 | listen_all */
  minSpeakLevel   String
  hostUserId      String
  livekitRoomName String    @unique
  /** live | ended */
  status          String    @default("live")
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  host         User                   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  participants LiveTalkParticipant[]
  ratings      LiveTalkRating[]
  invites      LiveTalkInvite[]

  @@index([status, createdAt])
}

model LiveTalkParticipant {
  id          String    @id @default(uuid())
  roomId      String
  userId      String
  /** host | cohost | speaker | listener */
  role        String
  /** When this person became co-host in this room (practice minutes count from here). */
  cohostSince DateTime?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  /** Host force-muted this mic; they cannot unmute until the host lifts it. */
  mutedByHost Boolean   @default(false)
  /** Set when the host kicks them; they cannot rejoin this room. */
  kickedAt    DateTime?

  room LiveTalkRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, leftAt])
  @@index([userId, leftAt])
}

/** Audit log: every host-level change, who made it and why (also feeds certificates). */
model HostLevelEvent {
  id          String   @id @default(uuid())
  userId      String
  fromLevel   String
  toLevel     String
  actorUserId String?
  /** scout_accepted | promoted_auto | manual | paused | demoted */
  reason      String
  note        String?
  roomId      String?
  createdAt   DateTime @default(now())

  user  User  @relation("HostLevelSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("HostLevelActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/** In-room invite: become a Host Trainee (scout) or a co-host of this room. */
model LiveTalkInvite {
  id          String    @id @default(uuid())
  /** trainee | cohost */
  kind        String
  roomId      String
  inviterId   String
  inviteeId   String
  /** pending | accepted | declined | expired */
  status      String    @default("pending")
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  room    LiveTalkRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User         @relation("LiveTalkInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User         @relation("LiveTalkInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([roomId, status])
}

/** Official Host's booked Live Talk time (host web /host). Times are UTC. */
model LiveTalkSession {
  id          String   @id @default(uuid())
  hostUserId  String
  title       String
  description String   @default("")
  startsAt    DateTime
  durationMin Int      @default(60)
  /** scheduled | cancelled */
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host User @relation("LiveTalkSessionHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@index([hostUserId, startsAt])
}

/** Leave-sheet thumbs for Live Talk room quality (MVP). */
model LiveTalkRating {
  id              String   @id @default(uuid())
  userId          String
  roomId          String
  /** up | down */
  rating          String
  /** Optional note — used when the learner taps 👎. */
  feedback        String?
  listenedSeconds Int?
  createdAt       DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  room LiveTalkRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId, createdAt])
  @@index([roomId, rating, createdAt])
  @@index([rating, createdAt])
}

/** Seasonal event layered on existing mini-game leaderboards. */
model Event {
  id                     String      @id @default(uuid())
  gameKey                String
  topicId                String?
  name                   String
  startsAt               DateTime
  endsAt                 DateTime
  timezone               String      @default("Asia/Bangkok")
  enabled                Boolean     @default(false)
  autoDistributeRewards  Boolean     @default(true)
  status                 EventStatus @default(DRAFT)
  rewardHold             Boolean     @default(false)
  headlineTh             String?
  headlineEn             String?
  bannerImageUrl         String?
  ctaRoute               String?
  startNotifiedAt        DateTime?
  endingSoonNotifiedAt   DateTime?
  endedNotifiedAt        DateTime?
  snapshotAt             DateTime?
  rewardedAt             DateTime?
  archivedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  rewardTiers EventRewardTier[]
  leaderboard EventLeaderboard[]
  attempts    EventScoreAttempt[]
  results     EventResult[]
  grants      EventRewardGrant[]

  @@index([gameKey, status])
  @@index([status, startsAt, endsAt])
}

model EventRewardTier {
  id             String          @id @default(uuid())
  eventId        String
  rankFrom       Int
  rankTo         Int
  rewardType     EventRewardType @default(AVATAR)
  avatarId       String
  avatarImageUrl String?
  nameTh         String
  nameEn         String
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  event  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grants EventRewardGrant[]

  @@index([eventId, rankFrom])
}

model EventLeaderboard {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  bestScore   Int
  playCount   Int      @default(1)
  displayName String?
  avatarId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, bestScore])
}

model EventScoreAttempt {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  score     Int
  topicId   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, userId, createdAt])
  @@index([eventId, createdAt])
}

model EventResult {
  id          String   @id @default(uuid())
  eventId     String
  userId      String
  rank        Int
  score       Int
  displayName String?
  avatarId    String?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, rank])
}

model EventRewardGrant {
  id             String    @id @default(uuid())
  eventId        String
  userId         String
  rewardTierId   String
  avatarId       String
  avatarImageUrl String?
  nameTh         String
  nameEn         String
  rank           Int
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardTier EventRewardTier @relation(fields: [rewardTierId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, rewardTierId])
  @@index([userId, seenAt])
}

model EventJobLock {
  id        String   @id @default(uuid())
  jobKey    String
  runKey    String
  createdAt DateTime @default(now())

  @@unique([jobKey, runKey])
}
