generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  BANANA
  XP
  BANANA_SEED
}

model User {
  id                      String    @id @default(uuid())
  anonymousId             String    @unique
  displayName             String?
  timezone                String    @default("Asia/Bangkok")
  onboardingCompleted     Boolean   @default(false)

  bananaBalance           Int       @default(0)
  /** Daily free pool (capped). Spends this before accumulated bananas. */
  freeBananaBalance       Int       @default(0)
  xpBalance               Int       @default(0)
  bananaSeedBalance       Int       @default(0)
  unlockedAvatarIds       String[]  @default([])
  /** Currently selected profile avatar id (catalog). */
  avatarId                String?

  /** Most recent training lesson started (for social "currently on" proof). */
  lastStudiedLessonId     String?
  lastStudiedAt           DateTime?

  /** Last started mission / minigame (intro avatar stack). */
  lastActivityKind        String?
  lastActivityId          String?
  lastActivityAt          DateTime?

  streakDays              Int       @default(0)
  lastSessionDate         DateTime? @db.Date
  streakMilestonesClaimed Int[]     @default([])
  /** Highest streakDays ever reached (survives streak resets). */
  longestStreakDays       Int       @default(0)

  /** Lifetime Daily Speak completions (once per local day). */
  dailySpeakCount         Int       @default(0)

  /** Lifetime spoken turns accepted by the session API (not Continue taps). */
  spokenCount             Int       @default(0)

  lastDailyBananaDate     DateTime? @db.Date
  lastAppOpenDate         DateTime? @db.Date
  dailyMissionUsedDate    DateTime? @db.Date

  /** Top Free Talk memories from the latest session (max 5, overwritten each end). */
  freeTalkMemories        String[]  @default([])

  /** How Teacher B speaks during lessons: "thai" | "english". */
  lessonTeachingLanguage  String    @default("thai")

  /**
   * Self-reported English level from onboarding survey:
   * "beginner" | "elementary" | "intermediate" | "advanced"
   */
  selfReportedEnglishLevel String?

  /**
   * How the learner found Banana English (onboarding acquisition survey):
   * "tiktok" | "facebook" | "friend_line" | "google" | "app_store" | "other" | "skipped"
   */
  acquisitionSource String?

  /**
   * Onboarding demographics survey:
   * "female" | "male" | "prefer_not_say"
   */
  surveyGender String?

  /**
   * Onboarding age band:
   * "under_18" | "18_24" | "25_34" | "35_44" | "45_plus"
   */
  surveyAgeRange String?

  /** True after the learner finishes any Vocab Drill with zero mistakes. */
  perfectVocabDrillCompleted Boolean @default(false)

  /** Firebase Auth UID after linking Apple/Google sign-in. */
  firebaseUid             String?   @unique
  /** Primary email from linked auth provider(s). */
  email                   String?

  fcmTokens               UserFcmToken[]
  authProviders           UserAuthProvider[]
  transactions            EconomyTransaction[]
  sessions                UserSession[]
  lessonRatings           LessonRating[]
  notificationLogs        NotificationLog[]
  userNotifications       UserNotification[]
  achievements            UserAchievement[]
  outfits                 UserOutfit[]
  emojiSpeakEndlessWeeklyScores EmojiSpeakEndlessWeeklyScore[]
  explainItTopicScores      ExplainItTopicScore[]
  purchaseRecords           PurchaseRecord[]
  purchaseAttempts          PurchaseAttempt[]
  phonicsNodeProgress       PhonicsNodeProgress[]
  foundationChapterSkips    FoundationChapterSkip[]
  foundationSkipQuizAttempts FoundationSkipQuizAttempt[]
  miniGameScoreAttempts     MiniGameScoreAttempt[]
  bugReports                BugReport[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([lastStudiedLessonId, lastStudiedAt])
  @@index([lastActivityKind, lastActivityId, lastActivityAt])
}

model EconomyTransaction {
  id          String   @id @default(uuid())
  userId      String
  currency    Currency
  amount      Int
  source      String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserAuthProvider {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerUid String
  email       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id     String   @id @default(uuid())
  userId String
  type   String
  sentOn DateTime @db.Date
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sentOn])
}

model UserNotification {
  id     String    @id @default(uuid())
  userId String
  type   String
  title  String
  body   String
  data   Json?
  sentAt DateTime  @default(now())
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, readAt])
}

model UserSession {
  id              String    @id
  userId          String
  sessionType     String
  simulationId    String?
  lessonId        String?
  isDailyMission  Boolean   @default(false)
  rewardsApplied  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  overallScore    Int?
  scoreLabel      String?
  xpEarned        Int?
  seedsEarned     Int?
  durationSeconds Int?
  reportJson      Json?
  /** Hint sheet opens this session (null = not tracked / pre-achievements). */
  hintsUsed       Int?
  /** True if Thai Mix was used on any turn (null = not tracked). */
  thaiMixUsed     Boolean?
  /** Learner (user) turns this session (null = not tracked / pre-stats). */
  learnerTurnCount Int?
  /** Lesson teaching language for training sessions: "thai" | "english". */
  teachingLanguage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completedAt])
  @@index([userId, lessonId])
  @@index([lessonId, createdAt])
}

/** Learner star rating after finishing a lesson (1–5). */
model LessonRating {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  sessionId String?
  stars     Int
  /** Optional free-text feedback (usually when stars < 5). */
  feedback  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([lessonId, createdAt])
  @@index([userId, lessonId])
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  /** Set once the user claims the badge reward (null = reward still pending). */
  claimedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserOutfit {
  id       String   @id @default(uuid())
  userId   String
  outfitId String
  /** Achievement that granted this outfit (null = granted by other sources). */
  sourceAchievementId String?
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outfitId])
  @@index([userId])
}

/** Weekly personal best for Emoji Speak Endless (Mon–Sun, Asia/Bangkok week key). */
model EmojiSpeakEndlessWeeklyScore {
  id          String   @id @default(uuid())
  userId      String
  weekKey     String
  bestScore   Int
  displayName String?
  avatarId    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([weekKey, bestScore])
}

/** Personal best per Explain It topic (all-time Top 10). */
model ExplainItTopicScore {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  bestScore   Int
  displayName String?
  avatarId    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId, bestScore])
}

/** Server-owned phonics check attempts and pass state. */
model PhonicsNodeProgress {
  id           String   @id @default(uuid())
  userId       String
  nodeId       String
  attemptCount Int      @default(0)
  passed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, passed])
}

/** Chapter marked skipped after passing a skip quiz (≠ completed for badges). */
model FoundationChapterSkip {
  id              String   @id @default(uuid())
  userId          String
  pathId          String
  chapterId       String
  skippedNodeIds  Json
  quizCorrect     Int
  quizTotal       Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId, chapterId])
  @@index([userId, pathId])
}

/** Paid skip-quiz attempt; idempotencyKey prevents double banana charge on retry. */
model FoundationSkipQuizAttempt {
  id                 String   @id @default(uuid())
  userId             String
  pathId             String
  targetChapterId    String
  previousChapterId  String
  idempotencyKey     String
  items              Json
  totalCount         Int
  bananaCost         Int      @default(1)
  spendRef           String
  status             String   @default("started")
  correctCount       Int?
  passed             Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, pathId, targetChapterId])
}

/**
 * Append-only mini-game / path-stage scores (Say It, Describe It, Emoji Speak,
 * New Words, Skip Quiz, etc.) for admin Content analytics.
 */
model MiniGameScoreAttempt {
  id           String   @id @default(uuid())
  userId       String
  /** Canonical reward / stage id, e.g. say_it:fnd_v7_u03n04, skip_quiz:v7_u04. */
  gameId       String
  /** say_it | describe_it | emoji_speak | new_words | skip_quiz | other */
  kind         String
  correctCount Int
  totalCount   Int
  passed       Boolean?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([kind, createdAt])
  @@index([userId, gameId, createdAt])
}

/** Verified in-app purchase (RevenueCat / App Store / Play). */
model PurchaseRecord {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  storeTransactionId String   @unique
  bananasGranted     Int
  platform           String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** Store-paid IAP attempt, written before / even if claim fails. */
model PurchaseAttempt {
  id                 String   @id @default(uuid())
  userId             String?
  /** RevenueCat / Firebase app user id when the User row is not found yet. */
  appUserId          String?
  productId          String
  storeTransactionId String
  platform           String?
  source             String
  status             String
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/** In-app support tickets. Screenshots live in Firebase Storage (`screenshotPath`). */
model BugReport {
  id             String   @id @default(uuid())
  ticketNumber   Int      @unique @default(autoincrement())
  userId         String
  message        String
  screenshotPath String?
  appVersion     String?
  buildNumber    String?
  platform       String?
  locale         String?
  route          String?
  /** "open" | "done" */
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  category      String
  bodyMarkdown  String
  heroImageUrl  String?
  published     Boolean   @default(false)
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}
